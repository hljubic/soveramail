# ---- Sovera Mail: root environment (used by docker compose) ----
# Copy to .env and fill in the Google OAuth credentials.

# Host user (keeps bind-mounted files owned by you). `id -u` / `id -g`
UID=501
GID=20

APP_ENV=local
APP_DEBUG=false

# Where the pieces are reachable from the host (browser)
API_URL=http://localhost:8090
WEB_URL=http://localhost:3000
API_PORT_HOST=8090
WEB_PORT_HOST=3000
DB_PORT_HOST=3307

# MySQL
DB_DATABASE=soveramail
DB_USERNAME=sovera
DB_PASSWORD=sovera
DB_ROOT_PASSWORD=root

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, type "Web application")
# Authorized redirect URI must be exactly:  ${API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional shared secret between the web UI and the local API.
# Leave empty to disable. If set, every request must carry `X-Api-Key`.
API_KEY=

# Local AI safety: model server must be on this machine / private network unless true
AI_ALLOW_REMOTE=false

# Sync behaviour
MAIL_SYNC_INITIAL_LIMIT=100
MAIL_SYNC_INTERVAL_MINUTES=5
# Pause between download batches (ms); keeps big backfills under Gmail's per-user quota
MAIL_SYNC_BATCH_PAUSE_MS=600

# Set to true if Nuxt HMR does not pick up file changes inside Docker
CHOKIDAR_USEPOLLING=false
